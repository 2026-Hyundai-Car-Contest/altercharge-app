#!/bin/sh
# main으로 직접 푸시하는 것을 막는다. (모든 변경은 작업 브랜치 → PR → Squash and Merge)
# GitHub 무료 요금제의 비공개 저장소에서는 브랜치 보호를 쓸 수 없어서, 실수를 막는 용도로 둔다.
# 정말 필요한 경우에만: ALLOW_MAIN_PUSH=1 git push
[ "${ALLOW_MAIN_PUSH:-}" = "1" ] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main으로 직접 푸시할 수 없어요. 작업 브랜치를 푸시하고 PR을 열어 주세요."
    echo "  git switch -c feat/작업내용 && git push -u origin HEAD"
    echo "(정말 필요한 경우에만: ALLOW_MAIN_PUSH=1 git push)"
    exit 1
  fi
done
exit 0
