<?xml version="1.0" encoding="utf-8"?>
<!--
    공통 문구와 디자인 시스템 컴포넌트 문구
    카드 문구는 카드별 파일(strings_card_<카드명>.xml)에 각 담당이 넣는다.
    이름 규칙: <카드명 또는 컴포넌트명>_<요소>, 공통은 common_
-->
<resources>
    <string name="app_name" translatable="false">AlterCharge</string>

    <!-- 상단 바 (status_bar). Figma 06 Strings status_bar/state/{parked, charging, arrived} -->
    <string name="status_bar_parked">주차 중</string>
    <string name="status_bar_charging">충전 중</string>
    <string name="status_bar_arrived">도착</string>
    <!-- 기어 글자: 차량 표기라 번역하지 않는다 -->
    <string name="status_bar_gear_parked" translatable="false">P</string>
    <string name="status_bar_battery_percent">%1$s%%</string>
    <string name="status_bar_range">%1$skm</string>
    <string name="status_bar_temperature">%1$d°</string>

    <!-- 값 상태: 불러오는 중 / 제공되지 않거나 확인할 수 없음. Figma 06 Strings status_bar/data/{loading, unavailable} -->
    <string name="common_value_loading">확인 중</string>
    <string name="common_value_unavailable">정보 없음</string>
    <!-- MVP 고정 사용자 이름 (REQ_JD_003, Figma 시안 예시 이름과 같게). C 카드 헤드라인에 넣는다 -->
    <string name="common_driver_name">성진</string>
</resources>
