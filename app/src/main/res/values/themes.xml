<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 라이트: Compose 화면이 그려지기 전 창 배경이 검게 깜빡이지 않게 밝은 테마를 쓴다. 다크는 values-night -->
    <style name="Theme.AlterCharge" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 첫 프레임 전 창 배경을 화면 배경(screenBackground)과 맞춘다 -->
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
</resources>
