<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량(Automotive) 화면용 앱. 에뮬레이터와 폰 모두에서 설치되도록 required=false -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Vehicle SDK 퍼미션은 Pleos App Market과 협의·승인된 것만 선언한다. -->

    <!-- 백엔드 API 통신(충전소 · 주행 기록). 출시 빌드는 HTTPS만 쓴다(Pleos 앱 보안 가이드: TLS 1.2 이상).
         targetSdk 34는 기본으로 평문(http)을 막으므로 출시 빌드에는 따로 설정하지 않는다.
         INTERNET은 Android 일반 권한이라 위의 Vehicle SDK 퍼미션(Pleos 승인 대상)에 해당하지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 충전소 음성 검색(REQ_SL_003). Pleos SpeechToText가 Coming Soon이라 Android SpeechRecognizer를 쓴다.
         마이크는 음성 검색 버튼을 처음 누를 때만 요청한다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- targetSdk 30부터는 다른 앱의 서비스가 보이지 않아 SpeechRecognizer를 찾지 못한다 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AlterCharge">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
